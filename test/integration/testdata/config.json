[
  {
    "path": "/items/(?P<id>\\d+)",
    "method": "GET",
    "status": 200,
    "content": null
  },
  {
    "path": "/items",
    "method": "POST",
    "status": 200,
    "content": {
      "id": "{{ .System.random_int | raw }}",
      "name": "{{ .name }}",
      "validated": "{{ .config.validated | raw }}",
      "age": "{{ .age_years | raw }}",
      "type": "default"
    }
  },
  {
    "path": "/items/\\d+",
    "method": "DELETE",
    "status": 204,
    "content": null
  },
  {
    "path": "/orders",
    "method": "POST",
    "status": 200,
    "content": {
      "id": 1,
      "name": "a hardcoded name",
      "validated": "a hardcoded validated"
    }
  }
]
